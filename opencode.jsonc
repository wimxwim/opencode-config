{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "naraya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaraRouter",
      "options": {
        "baseURL": "https://router.bynara.id/v1",
        "apiKey": "{env:NARAROUTER_API_KEY}",
        "timeout": 300000,
        "chunkTimeout": 60000,
        "headerTimeout": 300000,
        "setCacheKey": true
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "agnes-2.5-flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "agnes-3-flash": {
          "name": "agnes-3-flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 512000,
            "output": 8192
          }
        },
        "claude-fable-5": {
