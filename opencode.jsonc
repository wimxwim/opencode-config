  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "playbook": {
      "path": "~/agensi/playbook",
      "description": "Agency SOP, execution playbooks, and AI workflow guides"
    },
    "agensi": {
      "path": "~/agensi",
      "description": "Agency hub - client projects, skills library, playbooks"
    },
    "gotongroyong-docs": {
      "path": "~/GotongRoyong/Docs-wa",
      "description": "GotongRoyong docs - super app modular specs, architecture, roadmap"
    },
    "skills": {
      "path": "~/agensi/skills",
      "description": "Reusable skills library - specialized workflows and automations"
    }
  },
  "enabled_providers": [
    "naraya"
  ],
  "model": "naraya/muse-spark-1.3-contributor",
  "agent": {
    "build": {
      "model": "naraya/muse-spark-1.3-contributor"
    },
    "sidekick": {
      "model": "naraya/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "naraya/qwen3.8-flash",
      "permission": {
        "playwright_*": "deny"
      }
    },
    "research": {
      "model": "naraya/qwen3.8-flash",
      "permission": {
        "playwright_*": "deny"
      }
    },
    "design": {
      "model": "naraya/mimo-v2.6-flash"
    },
    "reviewer": {
      "model": "naraya/glm-5.3-flash"
    },
    "plan": {
      "model": "naraya/muse-spark-1.3-contributor"
    },
    "vision": {
      "model": "naraya/mimo-v2.6-flash"
    }
  },
  "small_model": "naraya/qwen3.8-flash",
  "subagent_depth": 2,
  "snapshot": false,
  "compaction": {
    "prune": true,
    "auto": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/.state/**",
      "**/.next/**",
      "**/build/**",
      "**/.cache/**",
      "**/coverage/**",
      "**/.turbo/**",
      "**/*.log",
      "**/*.docx",
      "**/.opencode/**"
    ]
  },
  "lsp": true,
  "formatter": true,
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 150000
  },
  "experimental": {
    "batch_tool": true,
    "continue_loop_on_deny": false
  },
  "mcp": {
    "duckduckgo": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "duckduckgo-mcp-server[browser]",
        "duckduckgo-mcp-server"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "DDG_SEARCH_BACKEND": "auto",
        "DDG_SAFE_SEARCH": "MODERATE"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "timeout": 31000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase"
      ],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "timeout": 30000
    }
  },
  "permission": {
    "external_directory": {
      "~/agensi/**": "allow",
      "~/GotongRoyong/**": "allow",
      "~/GERAKAN_PEMUDA_BERDAYA/**": "allow",
      "~/.local/share/opencode/**": "allow"
    }
  }
}
